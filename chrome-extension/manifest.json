{
  "manifest_version": 3,
  "name": "Wishlist heirs",
  "version": "1.0.1",
  "description": "Adicione itens diretamente às suas listas de desejos a partir de qualquer e-commerce.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
